# Usado solo por `npm run build:mobile` / `npm run cap:sync` (--mode capacitor).
# La app empaquetada no tiene el proxy de Vite, así que necesita una URL absoluta
# al backend. Ajusta esta IP a la del equipo que corre `php artisan serve` en tu
# red local (o al dominio real en un build de producción).
VITE_API_URL=http://192.168.1.17:8000/api/v1
VITE_APP_NAME="ERP Vivero de Cacao"
